<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Sorteo Día del Niño</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FFF7EC;
    --ink:#33244F;
    --ink-soft:#6B5C86;
    --rosa:#FF5C8A;
    --amarillo:#FFC542;
    --turquesa:#1FBFA4;
    --violeta:#8257D6;
    --coral:#FF8A5B;
    --card-shadow:0 10px 0 rgba(51,36,79,.12), 0 18px 30px rgba(51,36,79,.14);
    --display:'Fredoka','Baloo 2',system-ui,-apple-system,'Segoe UI',sans-serif;
    --body:'Nunito',system-ui,-apple-system,'Segoe UI',sans-serif;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    font-family:var(--body);
    color:var(--ink);
    background:
      radial-gradient(1200px 500px at 50% -200px, #FFE9C7 0%, transparent 70%),
      var(--cream);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }

  /* ---- Papel picado ---- */
  .papel{width:100%;height:64px;display:block}
  .papel .flag{transform-origin:top center;animation:sway 4s ease-in-out infinite}
  @keyframes sway{0%,100%{transform:rotate(-1.2deg)}50%{transform:rotate(1.2deg)}}

  .wrap{max-width:720px;margin:0 auto;padding:8px 18px 60px}

  header{text-align:center;margin-top:6px}
  .eyebrow{
    font-family:var(--display);font-weight:600;letter-spacing:.14em;
    text-transform:uppercase;font-size:.72rem;color:var(--rosa);
    display:inline-block;background:#fff;border:2px solid #FFDCE6;
    padding:5px 14px;border-radius:999px;box-shadow:0 4px 0 rgba(255,92,138,.18)
  }
  h1{
    font-family:var(--display);font-weight:700;
    font-size:clamp(2.1rem,8vw,3.3rem);line-height:1.02;
    margin:.5rem 0 .2rem;letter-spacing:-.01em;
  }
  h1 .gift{display:inline-block;transform:translateY(4px)}
  .lead{font-size:1.02rem;color:var(--ink-soft);max-width:34ch;margin:.4rem auto 0;font-weight:600}

  .progress{
    display:flex;align-items:center;gap:12px;justify-content:center;
    margin:20px auto 6px;
  }
  .progress .bar{
    flex:0 0 160px;height:12px;border-radius:999px;background:#F0E4D2;
    overflow:hidden;border:2px solid #fff;box-shadow:inset 0 2px 3px rgba(51,36,79,.08)
  }
  .progress .bar > i{display:block;height:100%;width:0;border-radius:999px;
    background:linear-gradient(90deg,var(--turquesa),var(--amarillo));transition:width .5s cubic-bezier(.2,.9,.3,1.4)}
  .progress .label{font-family:var(--display);font-weight:600;color:var(--ink);font-size:.95rem;white-space:nowrap}

  /* ---- Grid de adultos ---- */
  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:22px}
  @media(min-width:560px){.grid{grid-template-columns:repeat(3,1fr)}}

  .name-card{
    position:relative;border:none;cursor:pointer;text-align:left;
    background:#fff;border-radius:22px;padding:18px 16px 16px;
    box-shadow:var(--card-shadow);font-family:var(--body);
    transition:transform .16s ease, box-shadow .16s ease;
    color:var(--ink);overflow:hidden;
  }
  .name-card:hover{transform:translateY(-3px)}
  .name-card:active{transform:translateY(1px);box-shadow:0 6px 0 rgba(51,36,79,.12),0 10px 18px rgba(51,36,79,.14)}
  .name-card:focus-visible{outline:3px solid var(--violeta);outline-offset:3px}
  .name-card .balloon{
    width:34px;height:42px;border-radius:50% 50% 50% 50%/58% 58% 42% 42%;
    position:relative;margin-bottom:12px;box-shadow:inset -6px -6px 0 rgba(0,0,0,.08)
  }
  .name-card .balloon::after{content:"";position:absolute;bottom:-8px;left:50%;
    width:2px;height:12px;background:rgba(51,36,79,.35);transform:translateX(-50%)}
  .name-card .who{font-family:var(--display);font-weight:600;font-size:1.28rem;line-height:1.1}
  .name-card .state{margin-top:6px;font-size:.82rem;font-weight:700;color:var(--ink-soft)}
  .name-card.done{background:#F3F8F3}
  .name-card.done .state{color:var(--turquesa)}
  .name-card.done::before{
    content:"✓";position:absolute;top:12px;right:14px;
    width:26px;height:26px;border-radius:50%;background:var(--turquesa);color:#fff;
    display:grid;place-items:center;font-weight:800;font-size:.9rem;
    box-shadow:0 3px 0 rgba(31,191,164,.4)
  }

  footer{text-align:center;margin-top:34px}
  .hint-note{font-size:.9rem;color:var(--ink-soft);font-weight:600;max-width:42ch;margin:0 auto 16px;line-height:1.4}
  .reset{
    background:none;border:2px dashed #E4D6C1;color:var(--ink-soft);
    font-family:var(--display);font-weight:600;font-size:.9rem;
    padding:9px 18px;border-radius:999px;cursor:pointer
  }
  .reset:hover{border-color:var(--rosa);color:var(--rosa)}

  /* ---- Modal ---- */
  .modal{
    position:fixed;inset:0;z-index:50;display:none;
    align-items:center;justify-content:center;padding:20px;
    background:rgba(51,36,79,.55);backdrop-filter:blur(4px)
  }
  .modal.open{display:flex}
  .sheet{
    position:relative;width:min(440px,94vw);background:var(--cream);
    border-radius:30px;padding:30px 26px 28px;text-align:center;
    box-shadow:0 24px 60px rgba(51,36,79,.4);
    animation:pop .35s cubic-bezier(.2,.9,.3,1.5)
  }
  @keyframes pop{from{transform:scale(.85) translateY(20px);opacity:0}to{transform:none;opacity:1}}
  .close{
    position:absolute;top:14px;right:14px;width:36px;height:36px;border-radius:50%;
    border:none;background:#fff;color:var(--ink);font-size:1.2rem;cursor:pointer;
    box-shadow:0 3px 0 rgba(51,36,79,.15);line-height:1
  }
  .close:hover{background:var(--rosa);color:#fff}
  .modal-who{font-family:var(--display);font-weight:600;font-size:1.05rem;color:var(--ink-soft)}
  .modal-who b{color:var(--ink)}

  /* ---- Caja de regalo ---- */
  .gift-stage{position:relative;height:210px;margin:14px auto 4px;width:180px}
  .giftbox{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);width:150px;height:130px;cursor:pointer}
  .giftbox .base{
    position:absolute;bottom:0;left:15px;width:120px;height:92px;border-radius:10px;
    background:linear-gradient(180deg,#FF7CA3,var(--rosa));
    box-shadow:inset 0 -10px 0 rgba(0,0,0,.08)
  }
  .giftbox .vrib{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:26px;height:92px;background:var(--amarillo)}
  .giftbox .lid{
    position:absolute;top:22px;left:0;width:150px;height:40px;border-radius:9px;
    background:linear-gradient(180deg,#FF6D97,#FF4E80);
    box-shadow:inset 0 -6px 0 rgba(0,0,0,.1);
    transition:transform .5s cubic-bezier(.3,-.4,.4,1.4),opacity .4s
  }
  .giftbox .lid .lrib{position:absolute;top:0;left:50%;transform:translateX(-50%);width:26px;height:40px;background:var(--amarillo)}
  .giftbox .bow{
    position:absolute;top:-16px;left:50%;transform:translateX(-50%);width:52px;height:26px;
    transition:transform .5s cubic-bezier(.3,-.4,.4,1.4),opacity .4s
  }
  .giftbox .bow::before,.giftbox .bow::after{
    content:"";position:absolute;top:0;width:26px;height:26px;border-radius:50% 50% 50% 0;
    background:var(--amarillo);box-shadow:inset -4px -4px 0 rgba(0,0,0,.08)
  }
  .giftbox .bow::before{left:0;transform:rotate(-20deg)}
  .giftbox .bow::after{right:0;transform:rotate(20deg) scaleX(-1)}
  .giftbox.shake{animation:shake .5s ease-in-out}
  @keyframes shake{0%,100%{transform:translateX(-50%) rotate(0)}20%{transform:translateX(-54%) rotate(-5deg)}40%{transform:translateX(-46%) rotate(5deg)}60%{transform:translateX(-53%) rotate(-4deg)}80%{transform:translateX(-47%) rotate(4deg)}}
  .giftbox.open .lid{transform:translateY(-120px) rotate(-14deg);opacity:0}
  .giftbox.open .bow{transform:translateX(-50%) translateY(-150px) rotate(30deg);opacity:0}

  .tap-hint{font-family:var(--display);font-weight:500;color:var(--ink-soft);margin-top:2px;font-size:1rem}
  .tap-hint .finger{display:inline-block;animation:tapmove 1.1s ease-in-out infinite}
  @keyframes tapmove{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}

  .result{display:none;margin-top:6px}
  .result.show{display:block;animation:rise .5s ease both}
  @keyframes rise{from{transform:translateY(14px);opacity:0}to{transform:none;opacity:1}}
  .result .to{font-family:var(--display);font-weight:500;color:var(--ink-soft);font-size:1.05rem}
  .result .kid{
    font-family:var(--display);font-weight:700;line-height:1.05;
    font-size:clamp(2.4rem,12vw,3.4rem);margin:2px 0 4px;
    background:linear-gradient(90deg,var(--violeta),var(--rosa),var(--coral));
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .result .emoji{font-size:1.7rem}
  .btn{
    margin-top:18px;font-family:var(--display);font-weight:600;font-size:1.05rem;
    border:none;border-radius:999px;padding:14px 26px;cursor:pointer;color:#fff;
    background:linear-gradient(180deg,#9B6BE8,var(--violeta));
    box-shadow:0 6px 0 #5E3EA6;transition:transform .12s
  }
  .btn:active{transform:translateY(3px);box-shadow:0 3px 0 #5E3EA6}
  .btn.ghost{background:none;color:var(--ink-soft);box-shadow:none;font-size:.92rem;padding:8px;margin-top:8px}
  .btn.ghost:hover{color:var(--rosa)}

  .already{display:none}
  .already.show{display:block}
  .already .lock{font-size:2.6rem}
  .already p{font-family:var(--display);font-weight:500;color:var(--ink);font-size:1.15rem;margin:8px 0 2px}
  .already small{color:var(--ink-soft);font-weight:700}

  canvas.confetti{position:fixed;inset:0;pointer-events:none;z-index:60;display:none}
  canvas.confetti.on{display:block}

  @media(prefers-reduced-motion:reduce){
    *{animation-duration:.001s !important;transition-duration:.15s !important}
    .papel .flag{animation:none}
  }
</style>
</head>
<body>

<!-- Papel picado -->
<svg class="papel" viewBox="0 0 720 64" preserveAspectRatio="none" aria-hidden="true" id="papel"></svg>

<div class="wrap">
  <header>
    <span class="eyebrow">Sorteo familiar</span>
    <h1><span class="gift">🎁</span> Día del Niño <span class="gift">🎈</span></h1>
    <p class="lead">Cada grande toca su nombre y descubre en secreto a qué chico le regala.</p>

    <div class="progress" aria-live="polite">
      <div class="bar"><i id="progFill"></i></div>
      <span class="label" id="progLabel">0 de 5 ya vieron su regalo</span>
    </div>
  </header>

  <main class="grid" id="grid"></main>

  <footer>
    <p class="hint-note">💡 Usá un solo teléfono y pasalo de mano en mano: cada uno abre su cajita y se la pasa al siguiente. Así nadie ve el regalo de los demás.</p>
    <button class="reset" id="resetBtn">🔀 Hacer un sorteo nuevo</button>
  </footer>
</div>

<!-- Modal -->
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalWho">
  <div class="sheet">
    <button class="close" id="closeBtn" aria-label="Cerrar">✕</button>
    <p class="modal-who" id="modalWho">Sos <b>—</b></p>

    <!-- vista: abrir regalo -->
    <div id="viewOpen">
      <div class="gift-stage">
        <div class="giftbox" id="giftbox" role="button" tabindex="0" aria-label="Abrir el regalo">
          <div class="bow"></div>
          <div class="lid"><div class="lrib"></div></div>
          <div class="base"><div class="vrib"></div></div>
        </div>
      </div>
      <p class="tap-hint" id="tapHint"><span class="finger">👆</span> Tocá el regalo para abrirlo</p>

      <div class="result" id="result">
        <div class="to">Te toca regalarle a…</div>
        <div class="kid" id="kidName">—</div>
        <div class="emoji">🎉🧸🎈</div>
        <button class="btn" id="doneBtn">Listo — pasá el teléfono 👉</button>
      </div>
    </div>

    <!-- vista: ya lo vio -->
    <div class="already" id="viewAlready">
      <div class="lock">🤫</div>
      <p>Ya viste tu regalo</p>
      <small>Guardá el secreto hasta el Día del Niño</small><br>
      <button class="btn ghost" id="peekBtn">Lo olvidé, mostrármelo de nuevo</button>
    </div>
  </div>
</div>

<canvas class="confetti" id="confetti"></canvas>

<script>
(function(){
  "use strict";
  const ADULTS = ["Vanessa","Gonzalo","Giselle","Andrea","Gabriela"];
  const KIDS   = ["Justino","Amelia","Greta","Valentino","Milagros"];
  const PALETTE = ["#FF5C8A","#FFC542","#1FBFA4","#8257D6","#FF8A5B"];
  const CONFETTI_COLORS = ["#FF5C8A","#FFC542","#1FBFA4","#8257D6","#FF8A5B","#57C7FF"];
  const LS_KEY = "sorteoDiaDelNino_v1";
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---------- estado ---------- */
  function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
  function newState(){
    const kids = shuffle(KIDS);
    const assign = {}; ADULTS.forEach((ad,i)=>assign[ad]=kids[i]);
    return {assign, seen:{}};
  }
  function load(){
    try{
      const s = JSON.parse(localStorage.getItem(LS_KEY));
      if(s && s.assign && ADULTS.every(a=>s.assign[a])) return s;
    }catch(e){}
    const s = newState(); save(s); return s;
  }
  function save(s){ try{localStorage.setItem(LS_KEY, JSON.stringify(s));}catch(e){} }
  let state = load();

  /* ---------- render grid ---------- */
  const grid = document.getElementById("grid");
  function render(){
    grid.innerHTML = "";
    ADULTS.forEach((ad,i)=>{
      const seen = !!state.seen[ad];
      const b = document.createElement("button");
      b.className = "name-card" + (seen ? " done" : "");
      b.innerHTML =
        '<div class="balloon" style="background:'+PALETTE[i%PALETTE.length]+'"></div>'+
        '<div class="who">'+ad+'</div>'+
        '<div class="state">'+(seen ? "Ya vio su regalo 🤫" : "Tocá para ver tu regalo")+'</div>';
      b.addEventListener("click", ()=>openModal(ad));
      grid.appendChild(b);
    });
    const done = ADULTS.filter(a=>state.seen[a]).length;
    document.getElementById("progFill").style.width = (done/ADULTS.length*100)+"%";
    document.getElementById("progLabel").textContent = done+" de "+ADULTS.length+" ya vieron su regalo";
  }

  /* ---------- modal ---------- */
  const modal = document.getElementById("modal");
  const giftbox = document.getElementById("giftbox");
  const result = document.getElementById("result");
  const tapHint = document.getElementById("tapHint");
  const viewOpen = document.getElementById("viewOpen");
  const viewAlready = document.getElementById("viewAlready");
  let current = null, opening = false;

  function openModal(ad){
    current = ad;
    document.getElementById("modalWho").innerHTML = "Sos <b>"+ad+"</b>";
    resetGift();
    if(state.seen[ad]){
      viewOpen.style.display = "none";
      viewAlready.classList.add("show");
    }else{
      viewOpen.style.display = "";
      viewAlready.classList.remove("show");
    }
    modal.classList.add("open");
    document.getElementById("closeBtn").focus();
  }
  function closeModal(){ modal.classList.remove("open"); stopConfetti(); current=null; }

  function resetGift(){
    opening=false;
    giftbox.classList.remove("open","shake");
    result.classList.remove("show");
    tapHint.style.display = "";
    document.getElementById("doneBtn").textContent = "Listo — pasá el teléfono 👉";
  }

  function reveal(){
    if(opening) return; opening=true;
    const kid = state.assign[current];
    document.getElementById("kidName").textContent = kid;
    const go = ()=>{
      giftbox.classList.add("open");
      tapHint.style.display = "none";
      result.classList.add("show");
      burstConfetti();
      state.seen[current] = true; save(state); render();
    };
    if(reduce){ go(); }
    else{ giftbox.classList.add("shake"); setTimeout(go, 480); }
  }

  giftbox.addEventListener("click", reveal);
  giftbox.addEventListener("keydown", e=>{ if(e.key==="Enter"||e.key===" "){e.preventDefault();reveal();} });
  document.getElementById("doneBtn").addEventListener("click", closeModal);
  document.getElementById("closeBtn").addEventListener("click", closeModal);
  document.getElementById("peekBtn").addEventListener("click", ()=>{
    viewAlready.classList.remove("show");
    viewOpen.style.display = "";
    resetGift(); reveal();
  });
  modal.addEventListener("click", e=>{ if(e.target===modal) closeModal(); });
  document.addEventListener("keydown", e=>{ if(e.key==="Escape" && modal.classList.contains("open")) closeModal(); });

  /* ---------- reset ---------- */
  document.getElementById("resetBtn").addEventListener("click", ()=>{
    if(confirm("¿Hacer un sorteo nuevo? Se van a mezclar todos los regalos otra vez y se borra lo que ya vieron.")){
      state = newState(); save(state); render();
    }
  });

  /* ---------- confetti ---------- */
  const canvas = document.getElementById("confetti");
  const ctx = canvas.getContext("2d");
  let parts = [], raf = null;
  function sizeCanvas(){ canvas.width = innerWidth; canvas.height = innerHeight; }
  addEventListener("resize", sizeCanvas); sizeCanvas();
  function burstConfetti(){
    if(reduce) return;
    sizeCanvas();
    canvas.classList.add("on");
    const cx = innerWidth/2, cy = innerHeight*0.42;
    parts = [];
    for(let i=0;i<140;i++){
      const a = Math.random()*Math.PI*2, sp = 4+Math.random()*9;
      parts.push({
        x:cx, y:cy,
        vx:Math.cos(a)*sp, vy:Math.sin(a)*sp-6,
        g:.22+Math.random()*.1, w:6+Math.random()*7, h:9+Math.random()*8,
        rot:Math.random()*6.28, vr:(Math.random()-.5)*.4,
        color:CONFETTI_COLORS[i%CONFETTI_COLORS.length], life:0, ttl:90+Math.random()*40
      });
    }
    if(raf) cancelAnimationFrame(raf);
    tick();
  }
  function tick(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    let alive=false;
    for(const p of parts){
      p.life++; if(p.life>p.ttl) continue;
      alive=true;
      p.vy+=p.g; p.x+=p.vx; p.y+=p.vy; p.rot+=p.vr; p.vx*=.99;
      const fade = Math.max(0,1-(p.life/p.ttl));
      ctx.save(); ctx.globalAlpha=fade; ctx.translate(p.x,p.y); ctx.rotate(p.rot);
      ctx.fillStyle=p.color; ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h); ctx.restore();
    }
    if(alive){ raf=requestAnimationFrame(tick); }
    else{ stopConfetti(); }
  }
  function stopConfetti(){ if(raf) cancelAnimationFrame(raf); raf=null; ctx.clearRect(0,0,canvas.width,canvas.height); canvas.classList.remove("on"); }

  /* ---------- papel picado ---------- */
  (function buildPapel(){
    const svg = document.getElementById("papel");
    const colors = PALETTE;
    const n = 12, w = 720/n;
    let s = '<line x1="0" y1="6" x2="720" y2="6" stroke="#C9B79B" stroke-width="2"/>';
    for(let i=0;i<n;i++){
      const x=i*w, c=colors[i%colors.length];
      s+='<g class="flag" style="animation-delay:'+(i*.18)+'s">';
      s+='<path d="M'+x+' 6 L'+(x+w)+' 6 L'+(x+w)+' 34 L'+(x+w/2)+' 50 L'+x+' 34 Z" fill="'+c+'"/>';
      // cutout deco
      s+='<circle cx="'+(x+w/2)+'" cy="20" r="4.5" fill="'+ '#FFF7EC' +'"/>';
      s+='<circle cx="'+(x+w*0.28)+'" cy="16" r="2.4" fill="#FFF7EC"/>';
      s+='<circle cx="'+(x+w*0.72)+'" cy="16" r="2.4" fill="#FFF7EC"/>';
      s+='</g>';
    }
    svg.innerHTML = s;
  })();

  render();
})();
</script>
</body>
</html>
